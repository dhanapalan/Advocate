# Copy to .env and fill in.
#
# Local development — `supabase start` / `supabase status` prints these:
#   SUPABASE_URL=http://127.0.0.1:54321
#   SUPABASE_PUBLISHABLE_KEY=<publishable key from the status output>
#
# Both the bare and VITE_-prefixed names are needed: VITE_* is inlined into the
# browser bundle, the bare names are read during SSR.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# AI assistant, drafting and dictation. Any OpenAI-compatible endpoint.
# Defaults to https://api.openai.com/v1 and gpt-4o-mini when unset.
AI_GATEWAY_API_KEY=""
# AI_GATEWAY_URL=""
# AI_GATEWAY_MODEL=""
# AI_GATEWAY_TRANSCRIBE_MODEL=""

# Clients microservice (services/clients/) — defaults to the deployed
# Worker in code, override to point at `wrangler dev` locally.
# VITE_CLIENTS_SERVICE_URL="http://localhost:8787"

# Matters microservice (services/matters/) — same pattern as above.
# VITE_MATTERS_SERVICE_URL="http://localhost:8788"

# Diary & Cause-list microservice (services/diary/) — same pattern as above.
# VITE_DIARY_SERVICE_URL="http://localhost:8789"

# Documents microservice (services/documents/) — same pattern as above.
# VITE_DOCUMENTS_SERVICE_URL="http://localhost:8790"
